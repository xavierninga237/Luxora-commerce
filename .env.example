# Copy these into Vercel → Project → Settings → Environment Variables
# (or into .env.local when running `vercel dev`). Never commit real keys.

# Required — create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional — main model. Paid models need credits on your OpenRouter account.
# To run 100% free, set this to: openrouter/free
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional — backups tried in order if the main model fails (no credits,
# rate limit, outage, empty reply). "openrouter/free" automatically picks
# whichever free model is available. Default: openrouter/free
OPENROUTER_FALLBACK_MODELS=openrouter/free

# Optional — your deployed URL and app name (shown in your OpenRouter dashboard)
OPENROUTER_SITE_URL=https://your-project.vercel.app
OPENROUTER_APP_NAME=Luxora Commerce
