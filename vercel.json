{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/concierge.js": { "maxDuration": 30, "includeFiles": "data/*.json" }
  },
  "redirects": [
    { "source": "/admin", "destination": "/admin/dashboard.html", "permanent": false },
    { "source": "/admin/", "destination": "/admin/dashboard.html", "permanent": false },
    { "source": "/demo", "destination": "/admin/dashboard.html", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
